{
  "manifest_version": 3,
  "name": "HoneLENS: Nursing EBP & Dosage Calc",
  "short_name": "HoneLENS",
  "version": "1.0.0",
  "description": "Chrome side-panel extension for US nursing students: source verification, EBP assignment builder, and deterministic dosage drills.",
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://api.crossref.org/*",
    "https://www.ebi.ac.uk/europepmc/*",
    "https://id.nlm.nih.gov/*",
    "https://live.dodopayments.com/*",
    "https://test.dodopayments.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open HoneLENS",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
